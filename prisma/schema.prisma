// ── Identidad visual por cliente ─────────────────────────────────────────────

enum BrandSource {
  WEBSITE
  INSTAGRAM
  UPLOAD
  MANUAL
}

enum ThemeMode {
  LIGHT
  DARK
}

enum BrandStatus {
  DRAFT
  APPROVED
}

/// Tema del espacio de trabajo de un cliente.
/// Los colores se validan por contraste antes de aprobarse: una marca oscura o
/// de bajo contraste no puede dejar el panel ilegible.
model ClientBrand {
  id       String @id @default(cuid())
  clientId String @unique

  source      BrandSource @default(MANUAL)
  sourceUrl   String?
  extractedAt DateTime?
  /// Lo que devolvió la extracción, tal cual. Sirve para rehacer sin volver a scrapear.
  rawExtraction Json?

  logoStorageKey    String?
  logoContentType   String?
  logoIsDark        Boolean @default(false)
  faviconStorageKey String?

  /// Paleta en hexadecimal. Se aplica como variables CSS en el espacio del cliente.
  primary    String @default("#3b5bdb")
  onPrimary  String @default("#ffffff")
  accent     String @default("#5c7cfa")
  background String @default("#f8f9fb")
  surface    String @default("#ffffff")
  text       String @default("#171a21")
  muted      String @default("#5b6270")
  border     String @default("#e2e6ee")

  fontHeading String?
  fontBody    String?
  radius      Int       @default(12)
  mode        ThemeMode @default(LIGHT)

  /// Imagen real de la marca, sacada de su sitio: la foto de producto o la
  /// escena que usan en su portada. Se muestra tratada y translúcida detrás del
  /// contenido del portal, y GANA sobre el mural dibujado: una imagen propia
  /// reconoce a la marca mejor que cualquier ilustración inventada.
  backdropStorageKey  String?
  backdropContentType String?
  /// De dónde se sacó. Sin esto nadie puede explicar por qué está esa imagen.
  backdropSourceUrl   String?
  /// Cuánto se atenúa, de 4 a 30. Lo ajusta la agencia mirando la previsualización.
  backdropOpacity     Int?

  /// Ilustración de marca dibujada por IA, en SVG ya saneado. Se usa cuando NO
  /// hay imagen del sitio. Es decoración: nunca lleva información, así que su
  /// ausencia no cambia lo que la pantalla dice.
  muralSvg         String?
  /// Qué se ve en el mural, para quien usa lector de pantalla.
  muralAlt         String?
  muralGeneratedAt DateTime?

  /// Ignora fondos y tipografías de marca y usa el tema neutro. Se activa solo
  /// cuando la paleta no alcanza el contraste mínimo.
  safeMode       Boolean @default(false)
  contrastReport Json?

  status      BrandStatus @default(DRAFT)
  appliedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  version     Int         @default(1)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_brands")
}

// ── Análisis con IA ──────────────────────────────────────────────────────────

enum AiInsightKind {
  PROFILE_FIT
  CREATIVE_IDEAS
  CAMPAIGN_ANALYSIS
  CAMPAIGN_REPORT
  BRAND_MURAL
}

enum AiJobStatus {
  RUNNING
  READY
  FAILED
}

/// Resultado de un análisis con IA.
/// Guarda el modelo, la versión del prompt y QUÉ DATOS se le pasaron, para que
/// la salida siempre se pueda explicar y auditar.
model AiInsight {
  id          String  @id @default(cuid())
  clientId    String
  campaignId  String?
  candidacyId String?

  kind   AiInsightKind
  status AiJobStatus   @default(RUNNING)

  model         String
  promptVersion String
  /// Resumen legible de las entradas: qué perfiles, qué métricas, qué brief.
  inputsSummary Json
  /// Huella de las entradas, para no repetir el mismo análisis sin que nada cambie.
  inputsDigest  String

  output     Json?
  outputText String?
  errorMessage String?

  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(12, 6)

  /// La agencia decide si el cliente ve este análisis.
  clientVisible Boolean @default(false)

  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign  Campaign?  @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)
  candidacy Candidacy? @relation(fields: [candidacyId, clientId], references: [id, clientId], onDelete: Cascade)

  @@index([clientId, kind, createdAt])
  @@index([campaignId, kind])
  @@index([inputsDigest])
  @@map("ai_insights")
}

// ── Scouting con proveedor externo ───────────────────────────────────────────

enum ScoutingMode {
  /// Descubrir perfiles nuevos por hashtag, palabra clave o similares.
  DISCOVER
  /// Traer métricas frescas de perfiles que ya tenemos.
  ENRICH
}

enum ScoutingStatus {
  PREVIEW
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Una corrida de scouting contra el proveedor externo.
/// Cuesta plata de verdad, así que cada corrida declara su costo estimado antes
/// de ejecutarse y queda contra un presupuesto con tope duro.
model ScoutingRun {
  id         String  @id @default(cuid())
  clientId   String
  campaignId String?

  provider String
  mode     ScoutingMode
  platform Platform
  /// Los parámetros de la búsqueda, tal como se enviaron.
  query    Json

  status ScoutingStatus @default(PREVIEW)

  requestedRecords Int      @default(0)
  deliveredRecords Int      @default(0)
  unitCostUsd      Decimal  @db.Decimal(12, 6)
  estimatedCostUsd Decimal  @db.Decimal(12, 4)
  actualCostUsd    Decimal? @db.Decimal(12, 4)

  externalJobId String?
  errorMessage  String?
  summary       Json?

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)
  results  ScoutingResult[]

  @@index([clientId, startedAt])
  @@index([status])
  @@map("scouting_runs")
}

model ScoutingResult {
  id       String @id @default(cuid())
  runId    String
  clientId String

  platform Platform
  handle   String?
  url      String
  urlNormalized String
  displayName   String?
  followers     Int?
  engagementRate Decimal? @db.Decimal(6, 3)
  country       String?
  bio           String?
  raw           Json?

  /// Influencer existente con el que coincide, si lo hay.
  matchedInfluencerId String?
  imported            Boolean @default(false)
  importedAt          DateTime?
  discarded           Boolean @default(false)

  createdAt DateTime @default(now())

  run ScoutingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, urlNormalized])
  @@index([clientId, imported])
  @@map("scouting_results")
}

/// Tope de gasto por período. `clientId` nulo es el tope global de la agencia.
model ScoutingBudget {
  id       String  @id @default(cuid())
  clientId String?
  /// Período en formato AAAA-MM.
  period   String
  limitUsd Decimal @db.Decimal(12, 2)
  spentUsd Decimal @default(0) @db.Decimal(12, 4)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@map("scouting_budgets")
}

/// Archivo guardado en la base.
///
/// El logo de una marca y el Excel importado no pueden vivir en el disco del
/// servidor: en Vercel es efímero y se pierde en cada despliegue. Guardarlos
/// acá evita depender de un bucket externo para que el producto funcione, y
/// hace que desarrollo y producción se comporten igual.
///
/// `clientId` no es decorativo: es lo que permite que RLS filtre estos bytes
/// como filtra todo lo demás.
model StoredBlob {
  key         String @id
  clientId    String?
  filename    String
  contentType String
  size        Int
  sha256      String
  data        Bytes

  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("stored_blobs")
}

// ── Plata: qué se acordó, qué se pagó y qué falta ───────────────────────────

/// Cómo cobra la agencia por esta campaña.
enum AgencyFeeMode {
  /// Un porcentaje de lo que se invierte en talento.
  PERCENT
  /// Un monto fijo, sin importar cuánto se gaste en talento.
  FIXED
  /// La agencia no cobra fee acá (retainer, canje, prueba).
  NONE
}

/// Hacia dónde va la plata.
enum PaymentDirection {
  /// El cliente le paga a la agencia.
  AGENCY_IN
  /// La agencia le paga al influencer.
  TALENT_OUT
  /// Cualquier otro gasto de la campaña (producción, pauta, envíos).
  EXPENSE_OUT
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// Los términos económicos de una campaña. Uno por campaña.
model CampaignFinance {
  id         String @id @default(cuid())
  campaignId String @unique
  clientId   String

  feeMode    AgencyFeeMode @default(PERCENT)
  /// Porcentaje sobre la inversión en talento. Sólo se usa con feeMode PERCENT.
  feePercent Decimal?      @db.Decimal(6, 3)
  /// Monto fijo. Sólo se usa con feeMode FIXED.
  feeFixed   Decimal?      @db.Decimal(14, 2)

  /// Costos que no son cachet: producción, envíos, edición.
  productionCost Decimal? @db.Decimal(14, 2)
  /// Pauta paga sobre el contenido.
  adSpend        Decimal? @db.Decimal(14, 2)

  /// Condiciones de pago acordadas con el cliente, en texto libre.
  terms String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  campaign Campaign @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([campaignId, clientId])
  @@index([clientId])
  @@map("campaign_finances")
}

/// Un movimiento de plata. Prometido o hecho, pero siempre uno concreto.
model Payment {
  id          String  @id @default(cuid())
  clientId    String
  campaignId  String
  /// Cuando el movimiento es hacia un influencer concreto.
  candidacyId String?

  direction PaymentDirection
  status    PaymentStatus    @default(PENDING)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("USD")

  concept String
  dueDate DateTime?
  paidAt  DateTime?
  method  String?
  /// Número de factura, recibo o transferencia.
  reference String?
  notes     String?

  /// La factura adjunta, guardada en `stored_blobs`.
  documentKey  String?
  documentName String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  version     Int      @default(1)

  campaign  Campaign   @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)
  /*
   * Restrict y no SetNull: si hay plata anotada contra un influencer, sacarlo
   * de la campaña tiene que fallar hasta que alguien decida qué pasa con ese
   * movimiento. Un pago huérfano es un pago que nadie reclama.
   */
  candidacy Candidacy? @relation(fields: [candidacyId, clientId], references: [id, clientId], onDelete: Restrict)

  @@index([clientId, campaignId, direction])
  @@index([clientId, campaignId, status])
  @@index([candidacyId])
  @@map("payments")
}

// ── Links medidos: la única fuente de clics que es nuestra ──────────────────

/// Un link con UTMs que pasa por nosotros antes de llegar al destino.
model TrackedLink {
  id          String @id @default(cuid())
  clientId    String
  campaignId  String
  candidacyId String?

  /// Lo que va en la URL corta. Corto, sin ambigüedad, sin caracteres raros.
  slug        String @unique
  /// A dónde se manda a la persona, ya con los UTMs pegados.
  destination String

  utmSource   String
  utmMedium   String
  utmCampaign String
  utmContent  String?
  utmTerm     String?

  label    String?
  archived Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  campaign  Campaign   @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)
  /* Los clics ya medidos son historia: no se van con la candidatura. */
  candidacy Candidacy? @relation(fields: [candidacyId, clientId], references: [id, clientId], onDelete: Restrict)
  clicks    LinkClick[]

  @@index([clientId, campaignId])
  @@index([candidacyId])
  @@map("tracked_links")
}

/// Un clic. Se guarda lo mínimo para contar y para no contar dos veces al mismo.
model LinkClick {
  id     String @id @default(cuid())
  linkId String
  clientId String

  at        DateTime @default(now())
  /// Hash del visitante (IP + user agent + sal diaria). NUNCA la IP en claro.
  visitorHash String
  /// De dónde venía, si el navegador lo dijo. Sólo el host.
  referrerHost String?
  country      String?
  /// Si el patrón del user agent parecía un bot. Los bots se cuentan aparte.
  bot Boolean @default(false)

  link TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, at])
  @@index([clientId])
  @@map("link_clicks")
}

// ── Objetivos: qué se prometió y si se cumplió ──────────────────────────────

/// Qué se mide. Sólo entran métricas que el producto puede calcular hoy con
/// datos reales. Una métrica que no se puede medir no es un objetivo: es un
/// deseo, y un deseo con una barra de progreso al lado se lee como un hecho.
enum GoalMetric {
  /// Suma de seguidores del squad aprobado. Es una ESTIMACIÓN y se declara así.
  ALCANCE_ESTIMADO
  /// Suma del alcance real de las publicaciones, cargado a mano.
  ALCANCE_REAL
  /// Suma de visualizaciones de las publicaciones.
  VISUALIZACIONES
  /// Me gusta + comentarios + compartidos + guardados.
  INTERACCIONES
  /// Clics en los links medidos. Es lo único que medimos nosotros.
  CLICS
  /// Cantidad de publicaciones que salieron al aire.
  PUBLICACIONES
  /// Perfiles aprobados por el cliente.
  PERFILES_APROBADOS
  /// Inversión en talento. Se cumple NO pasándose.
  INVERSION_EN_TALENTO
}

/// De qué lado del número está el éxito.
enum GoalDirection {
  /// Llegar o superar el objetivo.
  AL_MENOS
  /// No pasarse del objetivo. Para topes de presupuesto.
  COMO_MUCHO
}

model CampaignGoal {
  id         String @id @default(cuid())
  campaignId String
  clientId   String

  metric    GoalMetric
  direction GoalDirection @default(AL_MENOS)
  target    Decimal       @db.Decimal(14, 2)
  /// Por qué se eligió ese número. Lo que hace que dentro de seis meses se
  /// pueda discutir el objetivo y no sólo el resultado.
  rationale String?

  /// Si el cliente lo ve en su portal. Un objetivo interno de la agencia
  /// -- "no pasarnos de tanto de cachet" -- no es asunto suyo.
  clientVisible Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  campaign Campaign @relation(fields: [campaignId, clientId], references: [id, clientId], onDelete: Cascade)

  @@unique([campaignId, metric])
  @@index([clientId, campaignId])
  @@map("campaign_goals")
}

/// Base de conocimiento propia de la agencia.
///
/// Cada búsqueda que se paga deja acá lo que encontró. La diferencia con
/// `ScoutingResult` es el alcance y la vida útil: aquél es el recibo de UNA
/// corrida para UN cliente --se archiva con ella--, y esto es lo que la agencia
/// sabe, acumulado, sin dueño.
///
/// Es la única tabla del sistema sin `clientId`, y es a propósito: un perfil de
/// Instagram no le pertenece a ningún cliente. Por eso la política de acceso no
/// es de aislamiento por cliente sino de agencia --sólo la agencia entra--, lo
/// mismo que ya rige para ejecutar scouting.
///
/// La idea detrás: cada consulta que se paga tiene que valer más de una vez.
model DiscoveredProfile {
  id String @id @default(cuid())

  platform      Platform
  url           String
  /// La URL canónica. Es la identidad del perfil: dos corridas que traen al
  /// mismo creador escriben la misma fila.
  urlNormalized String
  handle        String?
  displayName   String?

  /// Lo último que se supo. El recorrido completo vive en `metrics`.
  followers       Int?
  engagementRate  Decimal? @db.Decimal(6, 3)
  country         String?
  bio             String?
  /// La URL que devolvió el proveedor. Suele caducar: no se muestra.
  profileImageUrl String?
  /// La foto guardada por nosotros, en `stored_blobs`. Es la que se muestra.
  profileImageKey String?

  /// Con qué palabras apareció. Se acumulan: es cómo lo vuelve a encontrar
  /// quien busque por tema sin acordarse del nombre.
  keywords  String[] @default([])
  /// Intereses o categorías que informó el proveedor, cuando los informa.
  interests String[] @default([])
  /// Quiénes lo devolvieron. Procedencia: el producto siempre puede decir de
  /// dónde salió un dato.
  providers String[] @default([])

  /// Cuántas búsquedas distintas lo trajeron. Un perfil que aparece siempre
  /// para un tema es una señal, no ruido.
  timesSeen   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// Notas de la agencia sobre este perfil. Nunca se muestran a un cliente.
  internalNotes String?

  /// El influencer del padrón, cuando este perfil ya fue incorporado.
  /// Es el puente por el que la ficha muestra campañas y pagos sin copiarlos.
  influencerId String?
  influencer   Influencer? @relation(fields: [influencerId], references: [id], onDelete: SetNull)

  metrics DiscoveredProfileMetric[]

  @@unique([platform, urlNormalized])
  @@index([platform, followers])
  @@index([country])
  @@index([lastSeenAt])
  @@index([influencerId])
  @@map("discovered_profiles")
}

/// Cómo fueron cambiando los números de un perfil.
///
/// Se agrega una fila sólo cuando el dato cambió. Con el tiempo esto contesta
/// gratis algo por lo que hoy habría que pagarle a un proveedor: si un creador
/// está creciendo o cayendo.
model DiscoveredProfileMetric {
  id        String @id @default(cuid())
  profileId String

  followers      Int?
  engagementRate Decimal? @db.Decimal(6, 3)
  /// Quién lo midió. Dos proveedores pueden no coincidir, y hay que poder verlo.
  provider       String
  seenAt         DateTime @default(now())

  profile DiscoveredProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, seenAt])
  @@map("discovered_profile_metrics")
}
