// ── Importación ──────────────────────────────────────────────────────────────

enum ImportStatus {
  PREVIEW
  CONFIRMED
  CANCELLED
  FAILED
}

enum ImportOutcome {
  CREATED
  UPDATED
  UNCHANGED
  POSSIBLE_DUPLICATE
  /// El origen se contradice a sí mismo (p. ej. el texto dice un perfil y el hipervínculo apunta a otro).
  CONFLICT
