# ─────────────────────────────────────────────────────────────
# JC Influencers — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3100
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos (rol de aplicación, SIN privilegios de superusuario y SIN BYPASSRLS)
DATABASE_URL=postgresql://jc_app:jc_app_dev_password@localhost:55432/jc_influencers?schema=public
# Rol propietario, usado solo por `prisma migrate` (DDL). En producción se ejecuta a mano.
MIGRATION_DATABASE_URL=postgresql://jc_owner:jc_owner_dev_password@localhost:55432/jc_influencers?schema=public
# Base para los tests de integración
TEST_DATABASE_URL=postgresql://jc_app:jc_app_dev_password@localhost:55432/jc_influencers_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://jc_owner:jc_owner_dev_password@localhost:55432/jc_influencers_test?schema=public

# Secreto de sesión (32+ bytes). Generar con: openssl rand -base64 48
SESSION_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes

# Email. driver=console escribe los mails en ./.mail (desarrollo). driver=smtp usa SMTP real.
EMAIL_DRIVER=console
EMAIL_FROM="JC Influencers <no-reply@jcmarketing.digital>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Almacenamiento de archivos. driver=local escribe en ./storage. driver=s3 usa S3/MinIO.
# db  = en la base de datos (por defecto; funciona igual en local y en Vercel)
# s3  = bucket externo, si algún día los archivos justifican uno
# local = disco del servidor; sólo para desarrollo, se pierde en cada despliegue
STORAGE_DRIVER=db
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=jc-influencers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────
# Scouting con Bright Data (Web Scraper API)
# Sin token, la función se muestra deshabilitada. Nunca simula datos.
# Los identificadores de dataset se copian del panel de Bright Data.
# ─────────────────────────────────────────────────────────────
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_DATASET_INSTAGRAM_PROFILES=
BRIGHTDATA_DATASET_INSTAGRAM_DISCOVER=
BRIGHTDATA_DATASET_TIKTOK_PROFILES=
BRIGHTDATA_DATASET_YOUTUBE_PROFILES=
BRIGHTDATA_DATASET_YOUTUBE_DISCOVER=
BRIGHTDATA_DATASET_TIKTOK_DISCOVER=
# Costo por registro entregado, en dólares. Se usa para el aviso previo y el tope.
BRIGHTDATA_COST_PER_RECORD_USD=0.0015
# Tope mensual global de gasto en scouting, en dólares. Es un corte duro.
SCOUTING_MONTHLY_LIMIT_USD=50

# ─────────────────────────────────────────────────────────────
# Análisis con IA (Anthropic)
# Sin clave, la función se muestra deshabilitada. Nunca inventa un análisis.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Tope mensual de gasto en IA, en dólares. Es un corte duro.
AI_MONTHLY_LIMIT_USD=50

# Semilla de demo: contraseña de los usuarios ficticios.
SEED_DEMO_PASSWORD=Demo.2026!seguro

# ── Scouting: qué proveedor se usa ──────────────────────────────────────────
# brightdata  trae muy bien un perfil que ya conocés; buscando es lento y en
#             Instagram directamente no busca perfiles por palabra clave.
# apify       busca mejor y tiene tope de gasto del lado del proveedor.
# Cambiar de uno a otro es cambiar esta variable: la aplicación depende de la
# interfaz, no del proveedor.
SCOUTING_PROVIDER=brightdata

# Apify. Los actores los publica la comunidad y cambian de nombre, por eso van
# en variables. Se piden como `usuario~nombre-del-actor`.
# Sugeridos (verificar con `npm run scouting:check` antes de confiar):
#   TikTok      clockworks~tiktok-scraper
#   Instagram   apify~instagram-scraper
#   YouTube     streamers~youtube-scraper
APIFY_TOKEN=
APIFY_ACTOR_INSTAGRAM_PROFILES=
APIFY_ACTOR_INSTAGRAM_DISCOVER=
APIFY_ACTOR_TIKTOK_PROFILES=
APIFY_ACTOR_TIKTOK_DISCOVER=
APIFY_ACTOR_YOUTUBE_PROFILES=
APIFY_ACTOR_YOUTUBE_DISCOVER=
# Apify cobra por resultado y varía según el actor. Si acá dice menos de lo que
# cuesta, el tope de gasto que ve quien ejecuta deja de ser cierto.
APIFY_COST_PER_RECORD_USD=0.004
