# ─────────────────────────────────────────────────────────────
# JC Influencers — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3100
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos (rol de aplicación, SIN privilegios de superusuario y SIN BYPASSRLS)
DATABASE_URL=postgresql://jc_app:jc_app_dev_password@localhost:55432/jc_influencers?schema=public
# Rol propietario, usado solo por `prisma migrate` (DDL). En producción se ejecuta a mano.
MIGRATION_DATABASE_URL=postgresql://jc_owner:jc_owner_dev_password@localhost:55432/jc_influencers?schema=public
# Base para los tests de integración
TEST_DATABASE_URL=postgresql://jc_app:jc_app_dev_password@localhost:55432/jc_influencers_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://jc_owner:jc_owner_dev_password@localhost:55432/jc_influencers_test?schema=public

# Secreto de sesión (32+ bytes). Generar con: openssl rand -base64 48
SESSION_SECRET=cambiar-esto-por-un-secreto-largo-y-aleatorio-de-al-menos-32-bytes

# Email. driver=console escribe los mails en ./.mail (desarrollo). driver=smtp usa SMTP real.
EMAIL_DRIVER=console
EMAIL_FROM="JC Influencers <no-reply@jcmarketing.digital>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Almacenamiento de archivos. driver=local escribe en ./storage. driver=s3 usa S3/MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=jc-influencers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Semilla de demo: contraseña de los usuarios ficticios.
SEED_DEMO_PASSWORD=Demo.2026!seguro
